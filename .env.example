# Database (DATABASE_URL is required; POSTGRES_URL is fallback for prisma.config)
DATABASE_URL="postgresql://user:password@localhost:5432/esol_db"

# NextAuth Configuration
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# For production (Vercel), set these in your Vercel project settings:
# POSTGRES_URL or DATABASE_URL - Your PostgreSQL database URL (either works)
# NEXTAUTH_SECRET - A secure random string (use: openssl rand -base64 32)
# NEXTAUTH_URL - Your production URL (e.g., https://your-app.vercel.app)

CRON_SECRET="your-vercel-cron-secret-here"

# Web Push (VAPID) for daily vocab reminders
# Generate with: npm run push:generate-vapid
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"

# Local account passwords
# Choose unique local-only passwords; these are required for seeded accounts and auto-created system test students.
DEV_SEED_ACCOUNT_PASSWORD="set-a-unique-local-seed-password"
TEST_STUDENT_DEFAULT_PASSWORD="set-a-unique-local-system-student-password"

# Optional: ElevenLabs TTS (for pronunciation/minimal-pairs audio generation scripts)
ELEVENLABS_API_KEY="your-elevenlabs-api-key"
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"

# Optional: backup encryption key for scripts/db/backup-database-safe.ts
BACKUP_ENCRYPTION_KEY="a-long-random-secret-for-backup-encryption"

# Backup workflow (GitHub Actions) - not required for app runtime
# Use a direct PostgreSQL connection string suitable for pg_dump
BACKUP_DATABASE_URL="postgresql://user:password@host:5432/esol_db"

# Safety override for intentionally mutating a production-like DB target
ALLOW_PROD_DB_MUTATION="no"
CONFIRM_DB_HOST="db.example.com"

# Optional: performance query timing logs
# PERF_LOG_ENABLED defaults to true in production and false elsewhere
PERF_LOG_ENABLED="true"
# Warn threshold for query timing logs (milliseconds)
PERF_LOG_THRESHOLD_MS="300"
# Sampling rate from 0 to 1
PERF_LOG_SAMPLE_RATE="0.2"

# Optional: Sentry error tracking (only activates when DSN is set)
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
# NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
# SENTRY_ORG="your-org"
# SENTRY_PROJECT="your-project"

# Optional: feature flag for client submission outbox queue + banner
# Set to "true" to enable offline queueing and outbox status UI
NEXT_PUBLIC_ENABLE_SUBMISSION_OUTBOX="false"

# Optional: usernames to exclude from leaderboard rankings (comma-separated)
# Use for test accounts, admins, or other users who shouldn't appear on leaderboards
EXCLUDED_LEADERBOARD_USERNAMES="marlie,daniel,leah,matt"
