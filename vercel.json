{
  "buildCommand": "npm run build",
  "functions": {
    "src/app/**/*.{js,ts,jsx,tsx}": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/reset-weekly-points",
      "schedule": "0 0 * * 2"
    },
    {
      "path": "/api/cron/send-vocab-reminders",
      "schedule": "0 14 * * *"
    }
  ]
}
