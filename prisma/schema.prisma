generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                 @id @default(cuid())
  username               String                 @unique
  email                  String?                @unique
  name                   String?
  password               String
  role                   String                 @default("student")
  mustChangePassword     Boolean                @default(true)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  points                 Int                    @default(0)
  currentStreak          Int                    @default(0)
  longestStreak          Int                    @default(0)
  lastActivityDate       DateTime?
  weeklyPoints           Int                    @default(0)
  lastWeekRank           Int?
  avatar                 String?
  avatarColor            String?
  isSystemAccount        Boolean                @default(false)
  excludeFromLeaderboard Boolean                @default(false)
  passwordResetToken     String?                @unique
  passwordResetExpires   DateTime?
  activityProgress       ActivityProgress[]
  calendarEventsCreated  CalendarEvent[]
  createdClasses         Class[]                @relation("ClassTeacher")
  classes                ClassEnrollment[]
  createdInvites         InviteLink[]           @relation("CreatedInvites")
  feedbackEntries        Feedback[]
  pointsLedger           PointsLedger[]
  quizResponses          QuizResponse[]
  speakingSubmissions    SpeakingSubmission[]
  submissions            Submission[]
  achievements           UserAchievement[]
  preferences            UserPreferences?
  vocabReviewStates      UserVocabReviewState[]
  dailyHabitCompletions  DailyHabitCompletion[]
  pushSubscription       PushSubscription?
  teacherSessions        WritingSession[]       @relation("TeacherSessions")
  groupMemberships       WritingGroupMember[]   @relation("StudentGroupMembers")
  writingSubmissions     WritingSubmission[]    @relation("StudentWritingSubmissions")
  writingGroupVotes      WritingGroupVote[]     @relation("StudentGroupVotes")
  writingClassVotes      WritingClassVote[]     @relation("StudentClassVotes")
  writingCheckIns        WritingSessionCheckIn[] @relation("StudentCheckIns")

  @@index([role])
  @@index([isSystemAccount])
  @@index([weeklyPoints])
  @@index([role, weeklyPoints])
  @@index([email])
}

model Class {
  id             String            @id @default(cuid())
  name           String
  description    String?
  code           String            @unique
  teacherId      String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  announcement   String?
  sectionGroupId String?
  assignments     Assignment[]
  calendarEvents  CalendarEvent[]
  teacher         User              @relation("ClassTeacher", fields: [teacherId], references: [id])
  enrollments     ClassEnrollment[]
  writingSessions WritingSession[]

  @@index([teacherId])
  @@index([teacherId, createdAt])
  @@index([sectionGroupId])
  @@index([teacherId, sectionGroupId])
}

model ClassEnrollment {
  id        String   @id @default(cuid())
  classId   String
  studentId String
  joinedAt  DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id])
  student   User     @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId])
  @@index([classId])
  @@index([studentId])
}

model Activity {
  id                  String               @id @default(cuid())
  title               String
  description         String?
  type                String
  category            String?
  level               String?
  content             String
  createdBy           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  ui                  String?
  isReleased          Boolean              @default(false)
  isReleasedInContent Boolean?
  deletedAt           DateTime?
  progress            ActivityProgress[]
  assignments         Assignment[]
  quizResponses       QuizResponse[]
  speakingSubmissions SpeakingSubmission[]
  submissions         Submission[]
  writingSessions     WritingSession[]

  @@index([isReleased])
  @@index([isReleasedInContent])
  @@index([type, category, isReleased])
  @@index([deletedAt])
}

model ActivityProgress {
  id           String      @id @default(cuid())
  userId       String
  activityId   String
  progress     Int         @default(0)
  status       String      @default("in_progress")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  categoryData String?
  assignmentId String?
  activity     Activity    @relation(fields: [activityId], references: [id])
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId, assignmentId])
  @@index([userId])
  @@index([userId, activityId, updatedAt])
}

model SpeakingSubmission {
  id                       String      @id @default(cuid())
  userId                   String
  activityId               String
  assignmentId             String?
  selectedPromptIds        String[]
  soloSentences            String[]
  soloFollowUpQuestions    String[]
  soloCompletedStepIds     String[]
  speakingBestSentence     String
  speakingCompletedStepIds String[]
  submittedAt              DateTime    @default(now())
  status                   String      @default("submitted")
  activity                 Activity    @relation(fields: [activityId], references: [id])
  assignment               Assignment? @relation(fields: [assignmentId], references: [id])
  user                     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId, assignmentId])
  @@index([userId])
}

model PointsLedger {
  id        String   @id @default(cuid())
  userId    String
  points    Int
  reason    String?
  source    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
  @@index([source])
  @@index([userId, createdAt])
  @@index([source, createdAt])
}

model Assignment {
  id                  String               @id @default(cuid())
  classId             String
  activityId          String
  title               String?
  instructions        String?
  dueDate             DateTime?
  isFeatured          Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  activityProgress    ActivityProgress[]
  activity            Activity             @relation(fields: [activityId], references: [id])
  class               Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  quizResponses       QuizResponse[]
  speakingSubmissions SpeakingSubmission[]
  submissions         Submission[]

  @@index([classId])
  @@index([isFeatured])
  @@index([dueDate])
  @@index([classId, createdAt])
  @@index([classId, isFeatured, createdAt])
  @@index([classId, isFeatured, updatedAt])
}

model Submission {
  id            String      @id @default(cuid())
  userId        String
  activityId    String
  assignmentId  String?
  content       String
  score         Int?
  feedback      String?
  status        String      @default("pending")
  pointsAwarded Int         @default(0)
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  activity      Activity    @relation(fields: [activityId], references: [id])
  assignment    Assignment? @relation(fields: [assignmentId], references: [id])
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId, assignmentId])
  @@index([userId])
  @@index([status])
  @@index([assignmentId])
  @@index([status, assignmentId])
  @@index([userId, activityId, updatedAt])
  @@index([userId, status, completedAt])
}

model Feedback {
  id            String   @id @default(cuid())
  userId        String
  activityId    String?
  activityTitle String?
  difficulty    String?
  type          String
  message       String
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([activityId, createdAt])
  @@index([type, createdAt])
}

model Achievement {
  id               String            @id @default(cuid())
  name             String
  description      String
  icon             String
  type             String
  requirement      Int
  points           Int               @default(0)
  createdAt        DateTime          @default(now())
  userAchievements UserAchievement[]
}

model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  date        DateTime
  endDate     DateTime?
  type        String    @default("holiday")
  classId     String
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  class       Class     @relation(fields: [classId], references: [id])
  createdBy   User?     @relation(fields: [createdById], references: [id])

  @@index([classId])
  @@index([classId, date])
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime    @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId])
}

model QuizResponse {
  id           String      @id @default(cuid())
  userId       String
  activityId   String
  assignmentId String?
  questionId   String
  userAnswer   String
  isCorrect    Boolean
  skillTag     String?
  difficulty   String?
  topic        String?
  createdAt    DateTime    @default(now())
  activity     Activity    @relation(fields: [activityId], references: [id])
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activityId])
  @@index([skillTag])
  @@index([userId, activityId])
  @@index([activityId, skillTag])
}

model UserPreferences {
  id                   String   @id @default(cuid())
  userId               String   @unique
  hideVerbExplanations Boolean  @default(false)
  learnerMode          String   @default("classroom")
  weeklyActivityGoal   Int      @default(3)
  weeklyGoalStartDay   Int      @default(1) // 0=Sunday, 1=Monday
  skillFocus           String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([learnerMode])
}

model VocabCard {
  id             String                 @id @default(cuid())
  term           String
  normalizedTerm String                 @unique
  definition     String
  example        String?
  audioPath      String?
  sourceKeys     String[]
  sourceLabels   String[]
  unitNumbers    Int[]
  topics         String[]
  sortOrder      Int
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  reviewStates   UserVocabReviewState[]

  @@index([sortOrder])
}

model UserVocabReviewState {
  id                 String    @id @default(cuid())
  userId             String
  vocabCardId        String
  step               Int       @default(0)
  dueAt              DateTime
  lastReviewedAt     DateTime?
  lastRating         String?
  totalReviews       Int       @default(0)
  lapses             Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  difficulty         Float     @default(0.0)
  easeFactor         Float     @default(2.5)
  lastInterval       Int       @default(0)
  performanceHistory Float[]  @default([])
  stability          Float     @default(0.0)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabCard          VocabCard @relation(fields: [vocabCardId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabCardId])
  @@index([userId, dueAt])
  @@index([userId, updatedAt])
  @@index([userId, difficulty])
}

model DailyHabitCompletion {
  id          String   @id @default(cuid())
  userId      String
  habitKey    String
  dayKey      String
  completedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, habitKey, dayKey])
  @@index([userId, dayKey])
  @@index([habitKey, dayKey])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String   // Public key for encryption
  auth      String   // Auth secret
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId])
}

model AccountDeletionRecord {
  id        String   @id @default(cuid())
  username  String
  role      String
  reason    String
  deletedAt DateTime @default(now())

  @@index([deletedAt])
}

model InviteLink {
  id          String    @id @default(cuid())
  code        String    @unique
  createdById String
  createdBy   User      @relation("CreatedInvites", fields: [createdById], references: [id])
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([code])
  @@index([createdById])
}

// ── Live Writing Session Models ──────────────────────────────────────────────

model WritingSession {
  id           String    @id @default(cuid())
  activityId   String
  classId      String
  teacherId    String
  status       String    @default("waiting")
  currentRound Int       @default(0)
  timerEndsAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  activity  Activity                @relation(fields: [activityId], references: [id])
  class     Class                   @relation(fields: [classId], references: [id])
  teacher   User                    @relation("TeacherSessions", fields: [teacherId], references: [id])
  groups    WritingGroup[]
  rounds    WritingRound[]
  checkIns  WritingSessionCheckIn[]

  @@index([activityId, classId, status])
  @@index([teacherId])
}

model WritingGroup {
  id         String @id @default(cuid())
  sessionId  String
  animalName String
  colorHex   String

  session     WritingSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  members     WritingGroupMember[]
  submissions WritingSubmission[]

  @@index([sessionId])
}

model WritingGroupMember {
  id        String @id @default(cuid())
  groupId   String
  studentId String

  group   WritingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student User         @relation("StudentGroupMembers", fields: [studentId], references: [id])

  @@unique([groupId, studentId])
  @@index([studentId])
}

model WritingRound {
  id             String  @id @default(cuid())
  sessionId      String
  roundIndex     Int
  promptText     String
  promptImageUrl String?

  session     WritingSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  submissions WritingSubmission[]
  groupVotes  WritingGroupVote[]
  classVotes  WritingClassVote[]

  @@unique([sessionId, roundIndex])
}

model WritingSubmission {
  id            String   @id @default(cuid())
  roundId       String
  groupId       String
  studentId     String
  text          String
  wordCount     Int
  isGroupWinner Boolean  @default(false)
  submittedAt   DateTime @default(now())

  round      WritingRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  group      WritingGroup       @relation(fields: [groupId], references: [id])
  student    User               @relation("StudentWritingSubmissions", fields: [studentId], references: [id])
  groupVotes WritingGroupVote[]
  classVotes WritingClassVote[]

  @@unique([roundId, studentId])
  @@index([roundId, groupId])
}

model WritingGroupVote {
  id           String @id @default(cuid())
  roundId      String
  voterId      String
  submissionId String

  round      WritingRound      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  voter      User              @relation("StudentGroupVotes", fields: [voterId], references: [id])
  submission WritingSubmission @relation(fields: [submissionId], references: [id])

  @@unique([roundId, voterId])
}

model WritingClassVote {
  id           String @id @default(cuid())
  roundId      String
  voterId      String
  submissionId String

  round      WritingRound      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  voter      User              @relation("StudentClassVotes", fields: [voterId], references: [id])
  submission WritingSubmission @relation(fields: [submissionId], references: [id])

  @@unique([roundId, voterId])
}

model WritingSessionCheckIn {
  id        String   @id @default(cuid())
  sessionId String
  studentId String
  joinedAt  DateTime @default(now())

  session WritingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User           @relation("StudentCheckIns", fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@index([sessionId])
}
